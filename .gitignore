# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Kundendaten gehören nicht ins Repo.
# Angelegte Kunden bleiben lokal und werden als Vorschau-Link verschickt.
# Ausgenommen sind die vier erfundenen Beispielkunden.
/content/kunden/*.json
!/content/kunden/blessing.json
!/content/kunden/nordwerk.json
!/content/kunden/helia.json
!/content/kunden/voltana.json

# Kopierte Kundenlogos
/public/logos/
